-- import the libraries needed to import the dataset

import json
import requests
import pandas as pd
 1. Retrieve users from the API
url = "https://jsonplaceholder.typicode.com/users"

response = requests.get(url)

print(response.status_code)
3.extract json data 
data = response.json()

print(data)
4. checking the extracted data
print(type(data))

print(len(data))

print(data[0])
5. convert json data into DataFrame
df = pd.json_normalize(data)

print(df.head())
6.export extracted data
df.to_csv("extracted_users.csv", index=False)

print("Data extraction completed successfully!")
